          ),
          IOSUiSettings(
            title: 'Atur Background Profil',
            aspectRatioLockEnabled: true,
            resetAspectRatioEnabled: false,
          ),
        ],
      );

      if (cropped == null || !mounted) return;

      setState(() {
        _backgroundImage = XFile(cropped.path);
      });
    } catch (e) {
      _showError('Gagal memilih atau crop background: $e');
