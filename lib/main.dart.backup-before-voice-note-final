      );

      if (success) {
        await loadGroupMembers();
      }
    } catch (e) {
      if (!mounted) return;

      ScaffoldMessenger.of(context).showSnackBar(
        const SnackBar(
          backgroundColor: Colors.red,
          content: Text(
            'Tidak dapat terhubung ke M8.',
            style: TextStyle(color: m8White, fontWeight: FontWeight.w700),
          ),
        ),
      );
    }
  }

