                item['subtitle'] as String,
              ),
              trailing: const Icon(
                Icons.chevron_right_rounded,
              ),
              onTap: () {
                ScaffoldMessenger.of(context).showSnackBar(
                  SnackBar(
                    content: Text(
                      '${item['title']} siap diaktifkan.',
                    ),
                  ),
                );
              },
            ),
          );
        },
      ),
    );
  }
}
